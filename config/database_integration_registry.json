{
  "version": "2.0",
  "contract": "docs/03_Database/Database_Integration_Contract.md",
  "runtime_components": ["SUB-FINANCE", "SUB-HEALTH", "SUB-VEHICLE", "SUB-HOUSING", "SUB-FOOD", "SUB-KNOWLEDGE", "SUB-ROUTINE", "SUB-INVESTMENT", "SUB-JOB", "SUB-PERSONAL-GROWTH", "SUB-COLLABORATION"],
  "required_future_components": [],
  "contract_required_layers": ["OS System", "Capability", "Module", "Subsystem", "Engine Group", "Engine", "Function"],
  "rules": {
    "record_repository_required": true,
    "compatibility_adapter_allowed": true,
    "direct_sqlite_connection_forbidden": true,
    "data_owner_required": true,
    "execution_database_required": true,
    "migration_id_required": true,
    "integrity_check_required": true,
    "backup_restore_required": true,
    "operational_data_preservation_required": true,
    "physical_deduplication_forbidden": true
  },
  "operational_data_contract": {
    "version": 1,
    "storage": "SUB-DATABASE/operational_data",
    "retention_policy": "PRESERVE",
    "deduplication_policy": "LOGICAL_ONLY",
    "types": [
      "SUCCESS",
      "FAILURE",
      "ERROR",
      "WARNING",
      "INCIDENT",
      "RECOVERY",
      "ROLLBACK",
      "VALIDATION_FAILURE",
      "EXECUTION_FAILURE",
      "INVALID_DATA",
      "REJECTED_DECISION",
      "UNRESOLVED_ISSUE"
    ]
  }
}
