# Development defaults require no environment file.
# Production must replace every example path with an approved durable location.
LIVING_OS_ENV=production
LIVING_OS_DATA_ROOT=C:\LivingOS\persistent-data
LIVING_OS_BACKUP_ROOT=D:\LivingOS\independent-backups
LIVING_OS_STORAGE_DURABILITY=durable
LIVING_OS_BACKUP_INDEPENDENT=true
LIVING_OS_REQUIRE_AUTH=true
